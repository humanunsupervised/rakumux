{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "PermissionDenied": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "Notification": [{"matcher": "permission_prompt|idle_prompt|elicitation_dialog", "hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "StopFailure": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "StopCancelled": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent grok", "timeout": 3}]}]
  }
}
