{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "PostToolUseFailure": [{"matcher": "*", "hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "PermissionRequest": [{"matcher": "*", "hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "Notification": [{"matcher": "permission_prompt|idle_prompt", "hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "SubagentStart": [{"matcher": "*", "hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "SubagentStop": [{"matcher": "*", "hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"${RAKUMUX_BIN:-rakumux}\" session hook --agent claude", "timeout": 3}]}]
  }
}
