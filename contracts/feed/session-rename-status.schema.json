{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rakumux:feed:v1:session-rename-status",
  "title": "POST /api/v1/feed/session-renames/status request",
  "description": "The machine a rename was asked of says it renamed the session (`renamed`) or couldn't (`failed`, with why). Only a pending request changes, and only for the machine it names; otherwise the stored request comes back unchanged.",
  "x-maxBodyBytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "machine", "status"],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "urn:rakumux:feed:v1:common#/$defs/ulid" },
    "machine": { "$ref": "urn:rakumux:feed:v1:common#/$defs/machine" },
    "status": { "type": "string", "enum": ["renamed", "failed"] },
    "failure": { "$ref": "urn:rakumux:feed:v1:common#/$defs/sessionRenameFailure" }
  },
  "oneOf": [
    { "properties": { "status": { "const": "renamed" }, "failure": false } },
    {
      "required": ["failure"],
      "properties": {
        "status": { "const": "failed" },
        "failure": { "$ref": "urn:rakumux:feed:v1:common#/$defs/sessionRenameFailure" }
      }
    }
  ]
}
