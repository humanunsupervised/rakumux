{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rakumux:feed:v1:machine-credential",
  "title": "POST /api/v1/machines/credentials success",
  "description": "The enrolled machine's secret, given once: the cloud keeps only its hash. It does one thing, `POST /api/v1/machines/token`.",
  "x-maxBodyBytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "machine_id", "secret", "created_at"],
  "properties": {
    "version": { "const": 1 },
    "machine_id": { "$ref": "urn:rakumux:feed:v1:common#/$defs/ulid" },
    "secret": { "$ref": "#/$defs/secret" },
    "created_at": { "$ref": "urn:rakumux:feed:v1:common#/$defs/timestampMs" }
  },
  "$defs": {
    "secret": {
      "description": "`rkm_` and 32 random bytes, base64url without padding.",
      "type": "string",
      "pattern": "^rkm_[A-Za-z0-9_-]{43}$"
    }
  }
}
