{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rakumux:feed:v1:machine-credentials",
  "title": "GET /api/v1/machines/credentials success",
  "description": "The account's enrolled machines with a live credential, newest first; never a secret.",
  "x-maxBodyBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "machines"],
  "properties": {
    "version": { "const": 1 },
    "machines": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["machine_id", "name", "created_at", "last_exchanged_at"],
        "properties": {
          "machine_id": { "$ref": "urn:rakumux:feed:v1:common#/$defs/ulid" },
          "name": { "$ref": "urn:rakumux:feed:v1:common#/$defs/machine" },
          "created_at": { "$ref": "urn:rakumux:feed:v1:common#/$defs/timestampMs" },
          "last_exchanged_at": {
            "description": "When it last got an access token; null before its first.",
            "oneOf": [{ "$ref": "urn:rakumux:feed:v1:common#/$defs/timestampMs" }, { "type": "null" }]
          }
        }
      }
    }
  }
}
