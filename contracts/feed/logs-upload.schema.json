{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rakumux:feed:v1:logs-upload",
  "title": "POST /api/v1/feed/logs request",
  "description": "Warnings and errors from a machine's own Rakumux programs, for the owner's log viewer on rakumux.com. Sent only while the account's features read says `logs`. Every message is masked on the machine and again by the cloud: never prompts, chat text, terminal output or keystrokes. `id` is a ULID the machine made; uploading one again changes nothing, so retries never duplicate.",
  "x-maxBodyBytes": 131072,
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "machine", "events"],
  "properties": {
    "version": { "const": 1 },
    "machine": { "$ref": "urn:rakumux:feed:v1:common#/$defs/machine" },
    "release": { "description": "This Rakumux's version.", "type": "string", "minLength": 1, "maxLength": 32 },
    "platform": { "description": "Its operating system and architecture, `linux-x86_64`.", "type": "string", "minLength": 1, "maxLength": 32 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "at", "source", "level", "message"],
        "properties": {
          "id": { "$ref": "urn:rakumux:feed:v1:common#/$defs/ulid" },
          "at": { "$ref": "urn:rakumux:feed:v1:common#/$defs/timestampMs" },
          "source": { "enum": ["tui", "daemon", "api", "mcp", "account_service"] },
          "level": { "enum": ["debug", "info", "warn", "error"] },
          "component": { "description": "The part of the program, as a thread name.", "type": "string", "minLength": 1, "maxLength": 64 },
          "message": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    }
  }
}
