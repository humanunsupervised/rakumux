{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rakumux:feed:v1:chat-upload",
  "title": "POST /api/v1/feed/messages request",
  "description": "Up to 100 messages of one chat from one machine, any order. Each replaces a message of the same id.",
  "x-maxBodyBytes": 4194304,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "machine",
    "chat",
    "messages"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "machine": {
      "$ref": "urn:rakumux:feed:v1:common#/$defs/machine"
    },
    "chat": {
      "$ref": "urn:rakumux:feed:v1:common#/$defs/chat"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "urn:rakumux:feed:v1:common#/$defs/message"
      }
    }
  }
}
