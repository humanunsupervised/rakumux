install/npm/dist/
install/npm/resources/

# Homebrew formula backups - generated by update scripts
install/homebrew/Formula/*.bak

# Old package directories (from testing/debugging)
orchestra-macos-*/

# Build artifacts and test packages
test-package/

# Orchestra configuration directory
.orchestra/
